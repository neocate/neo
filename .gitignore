# Claves y secretos (NUNCA subir)
.env

# Entornos virtuales de Python
venv/
.venv/

# Cache de Python
__pycache__/
*.pyc

# Datos capturados en vivo (libro/OI) y velas descargadas - se regeneran
# corriendo herramientas/grabador_libro.py / descargar_bit.py, no se suben.
herramientas/libro/
historico_*.csv
flujo_*.csv

# 2026-08-13: grabador_libro.py escribe ahora en su propia carpeta (locks,
# config, comandos_grabador/, huecos_*.csv) en vez de compartir
# herramientas/libro/ - mismo criterio de "se regenera en vivo, no se sube".
herramientas/grabador_libro/

# 2026-08-14: descargar_bit.py --velas (historico permanente de Bitget) y
# niveles.py --actualizar (listado_<TF>.json + historial_<TF>.csv) - mismo
# criterio: se regeneran corriendo los scripts, no se suben.
herramientas/velas/
herramientas/niveles/

# Cache de historicos completos (Binance, 2017+) - GBs de datos (nombre
# real: <DD-MM-AA>_<COIN>_<TF>_binance.csv, sin prefijo "historico_" - por
# eso necesita su propio patron, el de arriba no lo cubre). Vive en
# <raiz>/historicos/ (lo que lee backtest_senales.py, DIR_HISTORICOS), se
# rellena por FTP - la regla antigua "herramientas/historicos/" apuntaba a
# donde escribe descargar_bin.py, que no es donde se lee de verdad (ver
# anotaciones.md 2026-08-12).
historicos/

# Logs de procesos lanzados en background (ej. nohup ... > libro.log &).
*.log

# 2026-08-17: parametros en caliente de mercado/indicadores.py y
# mercado/senales.py - mismo criterio que grabador_config.json
# (herramientas/grabador_libro/): se editan a mano o via
# telegram_control.py mas adelante, no se suben. Si no existen, cada
# modulo usa su PARAMS_DEFECTO tal cual (comportamiento identico al de
# antes de que existieran estos ficheros).
mercado/indicadores_config.json
mercado/senales_config.json

# Backup del .git corrupto anterior (ver anotaciones.md 2026-08-07) - no es
# parte del repo, se queda en disco por si hace falta mirar algo despues.
.git.corrupto-*/
